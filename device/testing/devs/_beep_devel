# beep_devel uci config file
#
# beep development settings

config main 'main'
    # 0 or 1. Whether to force the cluster_id provided in beep_data
    option force_cluster '1'

    # (string) Path to a version file, used by beepmanager_updates.
    option version_file_path '$VERSION_PATH'

    # 0 or 1. Passed by beepmanager through to Spotify, to enable the
    # Spotify library's debugging messages.
    option spotify_debug '1'

# These are ports for the various beep services, used by boom and passed
# through beepmanager to the individual programs.
config boom 'boom'
    option urelay_port $URELAY_PORT
    option playnet_port $PLAYNET_PORT
    option uhttpd_port $UHTTPD_PORT
    option ssdp_port $SSDP_PORT
    option dial_port $DIAL_PORT
    option msg_port $MSG_PORT
    option spotify_port $SPOTIFY_PORT
